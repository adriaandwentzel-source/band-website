---
import Layout from "../layouts/Layout.astro";
import { band } from "../lib/band";
---

<Layout title={band.labels.contact}>
  <section>
    <p class="eyebrow">
      {band.name} / {band.labels.booking}
    </p>
    <h1>{band.labels.contact}</h1>
    <p>{band.labels.contactIntro}</p>
    {band.contacts.map((c) => (
      <article class="epk-block ruled contact-card">
        <h2>{c.label}</h2>
        <a class="contact-email" href={`mailto:${c.email}`}>
          {c.email} ↗
        </a>
      </article>
    ))}
  </section>
</Layout>

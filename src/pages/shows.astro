---
import Layout from "../layouts/Layout.astro";
import { band, splitShows, today } from "../lib/band";
const shows = splitShows(today());
---

<Layout title={band.labels.shows}>
  <section>
    <p class="eyebrow">
      {band.name} / {band.labels.shows}
    </p>
    <h1>{band.labels.shows}</h1>
    {(["upcoming", "past"] as const).map((group) => (
      <div class="epk-block">
        <h2>{band.labels[group]}</h2>
        {shows[group].length ? (
          shows[group].map((s) => (
            <article class="show">
              <time datetime={s.date}>{s.date}</time>
              <div>
                <h3>{s.venue}</h3>
                <p>{s.city}</p>
              </div>
              {group === "upcoming" && s.ticketUrl && (
                <a class="btn primary" href={s.ticketUrl}>
                  {band.labels.tickets} ↗
                </a>
              )}
            </article>
          ))
        ) : (
          <p>{band.labels.noShows}</p>
        )}
      </div>
    ))}
  </section>
</Layout>
